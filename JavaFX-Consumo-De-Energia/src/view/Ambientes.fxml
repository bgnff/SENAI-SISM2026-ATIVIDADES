<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AmbientesController" styleClass="main-background">
    
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="⚡ EcoEnergy" styleClass="sidebar-title"/>
            <Label styleClass="sidebar-separator"/>
            
            <Button text="🏠 Dashboard" styleClass="sidebar-menu-item" onAction="#irParaDashboard"/>
            <Button text="🏢 Ambientes" styleClass="sidebar-menu-item" onAction="#irParaAmbientes"/>
            <Button text="⚡ Equipamentos" styleClass="sidebar-menu-item" onAction="#irParaEquipamentos"/>
            <Button text="➕ Cadastro" styleClass="sidebar-menu-item" onAction="#irParaCadastro"/>
            <Button text="📊 Relatórios" styleClass="sidebar-menu-item" onAction="#irParaRelatorios"/>
            <Button text="🌱 Simulação" styleClass="sidebar-menu-item" onAction="#irParaSimulacao"/>
            <Button text="💡 Ideias de Economia" styleClass="sidebar-menu-item" onAction="#irParaIdeias"/>
            
            <Label styleClass="sidebar-separator"/>
            <Button text="❌ Sair" styleClass="sidebar-menu-item" onAction="#sair"/>
        </VBox>
    </left>
    
    <center>
        <VBox styleClass="main-content" spacing="30" alignment="CENTER">
            
            <Label text="Cadastro de Ambientes" styleClass="label-title"/>
            
            <VBox styleClass="card" spacing="20" style="-fx-pref-width: 500px; -fx-padding: 40px;">
                
                <VBox spacing="8">
                    <Label text="Nome do Ambiente" styleClass="label-field"/>
                    <TextField fx:id="txtNome" promptText="Ex: Biblioteca" styleClass="text-field"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Descrição" styleClass="label-field"/>
                    <TextField fx:id="txtDescricao" promptText="Ex: Sala de leitura com 30 mesas" styleClass="text-field"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Ícone" styleClass="label-field"/>
                    <TextField fx:id="txtIcone" promptText="Ex: 📚 (emoji)" styleClass="text-field"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Categoria" styleClass="label-field"/>
                    <TextField fx:id="txtCategoria" promptText="Ex: Ensino" styleClass="text-field"/>
                </VBox>
                
                <HBox spacing="15" alignment="CENTER" style="-fx-padding-top: 10px;">
                    <Button text="Adicionar" styleClass="button-primary" onAction="#adicionarAmbiente" prefWidth="150"/>
                    <Button text="Limpar" styleClass="button-secondary" onAction="#limparCampos" prefWidth="150"/>
                </HBox>
                
            </VBox>
            
        </VBox>
    </center>
    
</BorderPane>
