<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController" styleClass="main-background">
    
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="⚡ EcoEnergy" styleClass="sidebar-title"/>
            <Label styleClass="sidebar-separator"/>
            
            <Button text="🏠 Dashboard" styleClass="sidebar-menu-item" onAction="#irParaDashboard"/>
            <Button text="🏢 Ambientes" styleClass="sidebar-menu-item" onAction="#irParaAmbientes"/>
            <Button text="⚡ Equipamentos" styleClass="sidebar-menu-item" onAction="#irParaEquipamentos"/>
            <Button text="➕ Cadastro" styleClass="sidebar-menu-item" onAction="#irParaCadastro"/>
            <Button text="📊 Relatórios" styleClass="sidebar-menu-item" onAction="#irParaRelatorios"/>
            <Button text="🌱 Simulação" styleClass="sidebar-menu-item" onAction="#irParaSimulacao"/>
            
            <Label styleClass="sidebar-separator"/>
            <Button text="❌ Sair" styleClass="sidebar-menu-item" onAction="#sair"/>
        </VBox>
    </left>
    
    <center>
        <VBox styleClass="main-content" spacing="30">
            
            <Label text="Dashboard" styleClass="label-title"/>
            
            <HBox spacing="20">
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 250px;">
                    <HBox spacing="15">
                        <Label text="⚡" styleClass="card-icon"/>
                        <VBox spacing="5">
                            <Label text="Consumo Total" styleClass="card-title"/>
                            <Label fx:id="lblConsumoTotal" text="0 kWh" styleClass="card-value"/>
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 250px;">
                    <HBox spacing="15">
                        <Label text="💰" styleClass="card-icon"/>
                        <VBox spacing="5">
                            <Label text="Valor Estimado" styleClass="card-title"/>
                            <Label fx:id="lblValorEstimado" text="R$ 0,00" styleClass="card-value"/>
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 250px;">
                    <HBox spacing="15">
                        <Label text="🌱" styleClass="card-icon"/>
                        <VBox spacing="5">
                            <Label text="Economia Possível" styleClass="card-title"/>
                            <Label fx:id="lblEconomiaPossivel" text="0 kWh" styleClass="card-value"/>
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 250px;">
                    <HBox spacing="15">
                        <Label text="🖥" styleClass="card-icon"/>
                        <VBox spacing="5">
                            <Label text="Equipamentos" styleClass="card-title"/>
                            <Label fx:id="lblQuantidadeEquipamentos" text="0" styleClass="card-value"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>
            
            <VBox styleClass="suggestions-panel" spacing="15">
                <Label text="💡 Sugestões de Economia" styleClass="suggestions-title"/>
                <VBox fx:id="sugestoesContainer" spacing="10"/>
            </VBox>
            
        </VBox>
    </center>
    
</BorderPane>
