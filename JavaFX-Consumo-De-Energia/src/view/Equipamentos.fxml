<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EquipamentosController" styleClass="main-background">
    
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="⚡ EcoEnergy" styleClass="sidebar-title"/>
            <Label styleClass="sidebar-separator"/>
            
            <Button text="🏠 Dashboard" styleClass="sidebar-menu-item" onAction="#irParaDashboard"/>
            <Button text="⚡ Equipamentos" styleClass="sidebar-menu-item" onAction="#irParaEquipamentos"/>
            <Button text="➕ Cadastro" styleClass="sidebar-menu-item" onAction="#irParaCadastro"/>
            <Button text="📊 Relatórios" styleClass="sidebar-menu-item" onAction="#irParaRelatorios"/>
            <Button text="🌱 Simulação" styleClass="sidebar-menu-item" onAction="#irParaSimulacao"/>
            
            <Label styleClass="sidebar-separator"/>
            <Button text="❌ Sair" styleClass="sidebar-menu-item" onAction="#sair"/>
        </VBox>
    </left>
    
    <center>
        <VBox styleClass="main-content" spacing="20">
            
            <Label text="Equipamentos Cadastrados" styleClass="label-title"/>
            
            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="txtPesquisa" promptText="Pesquisar equipamento..." styleClass="text-field" prefWidth="300"/>
                <Button text="🔍 Pesquisar" styleClass="button-primary" onAction="#pesquisar"/>
                <Button text="🔄 Atualizar" styleClass="button-secondary" onAction="#atualizarTabela"/>
            </HBox>
            
            <TableView fx:id="tabelaEquipamentos" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Nome" prefWidth="200" fx:id="colNome"/>
                    <TableColumn text="Tipo" prefWidth="150" fx:id="colTipo"/>
                    <TableColumn text="Potência (W)" prefWidth="120" fx:id="colPotencia"/>
                    <TableColumn text="Qtd" prefWidth="60" fx:id="colQuantidade"/>
                    <TableColumn text="Horas/dia" prefWidth="100" fx:id="colHoras"/>
                    <TableColumn text="Dias/mês" prefWidth="100" fx:id="colDias"/>
                    <TableColumn text="Consumo (kWh)" prefWidth="120" fx:id="colConsumo"/>
                </columns>
            </TableView>
            
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="✏️ Editar" styleClass="button-secondary" onAction="#editarEquipamento" prefWidth="120"/>
                <Button text="🗑️ Excluir" styleClass="button-danger" onAction="#excluirEquipamento" prefWidth="120"/>
            </HBox>
            
        </VBox>
    </center>
    
</BorderPane>
