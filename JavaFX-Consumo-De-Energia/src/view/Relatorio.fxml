<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RelatorioController" styleClass="main-background">
    
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="⚡ EcoEnergy" styleClass="sidebar-title"/>
            <Label styleClass="sidebar-separator"/>
            
            <Button text="🏠 Dashboard" styleClass="sidebar-menu-item" onAction="#irParaDashboard"/>
            <Button text="⚡ Equipamentos" styleClass="sidebar-menu-item" onAction="#irParaEquipamentos"/>
            <Button text="➕ Cadastro" styleClass="sidebar-menu-item" onAction="#irParaCadastro"/>
            <Button text="📊 Relatórios" styleClass="sidebar-menu-item" onAction="#irParaRelatorios"/>
            <Button text="🌱 Simulação" styleClass="sidebar-menu-item" onAction="#irParaSimulacao"/>
            
            <Label styleClass="sidebar-separator"/>
            <Button text="❌ Sair" styleClass="sidebar-menu-item" onAction="#sair"/>
        </VBox>
    </left>
    
    <center>
        <VBox styleClass="main-content" spacing="30">
            
            <Label text="Relatórios de Consumo" styleClass="label-title"/>
            
            <HBox spacing="20">
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 200px;">
                    <Label text="📦 Quantidade" styleClass="card-title"/>
                    <Label fx:id="lblQuantidade" text="0" styleClass="card-value"/>
                </VBox>
                
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 200px;">
                    <Label text="⚡ Consumo Total" styleClass="card-title"/>
                    <Label fx:id="lblConsumoTotal" text="0 kWh" styleClass="card-value"/>
                </VBox>
                
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 200px;">
                    <Label text="💰 Valor Total" styleClass="card-title"/>
                    <Label fx:id="lblValorTotal" text="R$ 0,00" styleClass="card-value"/>
                </VBox>
            </HBox>
            
            <HBox spacing="20">
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 280px;">
                    <Label text="🔥 Maior Consumidor" styleClass="card-title"/>
                    <Label fx:id="lblMaiorConsumidor" text="-" styleClass="label-white"/>
                    <Label fx:id="lblMaiorConsumo" text="0 kWh" styleClass="label-value"/>
                </VBox>
                
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 280px;">
                    <Label text="❄️ Menor Consumidor" styleClass="card-title"/>
                    <Label fx:id="lblMenorConsumidor" text="-" styleClass="label-white"/>
                    <Label fx:id="lblMenorConsumo" text="0 kWh" styleClass="label-value"/>
                </VBox>
                
                <VBox styleClass="card" spacing="10" style="-fx-pref-width: 200px;">
                    <Label text="📊 Média" styleClass="card-title"/>
                    <Label fx:id="lblMediaConsumo" text="0 kWh" styleClass="card-value"/>
                </VBox>
            </HBox>
            
            <VBox styleClass="card" spacing="15">
                <Label text="📈 Classificação do Consumo" styleClass="suggestions-title"/>
                <Label fx:id="lblClassificacao" text="Nenhum dado cadastrado" styleClass="label-white" style="-fx-font-size: 18px;"/>
            </VBox>
            
            <HBox alignment="CENTER_RIGHT">
                <Button text="🔄 Atualizar Relatório" styleClass="button-primary" onAction="#atualizarRelatorio" prefWidth="200"/>
            </HBox>
            
        </VBox>
    </center>
    
</BorderPane>
